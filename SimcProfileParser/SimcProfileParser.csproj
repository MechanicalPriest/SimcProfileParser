<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Not every public member has XML docs yet; do not warn about missing ones -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>4.8.0</Version>
	<AssemblyVersion>4.8.0</AssemblyVersion>
	<FileVersion>4.8.0</FileVersion>
	<Authors>Mechanical Priest</Authors>
	<Company>Mechanical Priest</Company>
	<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
	<RepositoryUrl>https://github.com/MechanicalPriest/SimcProfileParser</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageProjectUrl>https://github.com/MechanicalPriest/SimcProfileParser</PackageProjectUrl>
	<Copyright>Copyright © Mechanical Priest 2026</Copyright>
	<Description>A library to parse the simc WoW addon results into usable objects.</Description>
	<Summary>A library to parse the simc WoW addon results into usable objects.</Summary>
	<PackageTags>simc warcraft</PackageTags>
	<NeutralLanguage>en-US</NeutralLanguage>
	<Title>Simc Profile Parser</Title>
	<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	<PackageIcon>packageIcon.png</PackageIcon>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageReleaseNotes>4.8.0: Item enchants (SimcItem.Enchant, SimcItemOptions.EnchantId); gems and enchants scale to the player level (SimcItemOptions.PlayerLevel). 4.7.0: Catalysed items use their redirected_base_stats item's base stats (RedirectedBaseStatsItemId); fixed stamina on Midnight items, gems with two stats and crafted item stats. 4.6.0: Fixed item levels for Midnight items (item scaling config, crafting quality and squish bonuses) and squished item levels for older items; added ContentTuningId. 4.5.0: Spell effect ChainTargets and ChainMultiplier; documented Delta. 4.4.0: Player spell effect ScaledValue and PointsPerLevel; fixed scale budget for scaling classes -9/-10 and spells with a max scaling level. 4.3.0: Talent rank values (SimcSpellEffect.RankOperation/RankValues); fixed talent data not being parsed and a stack overflow generating player spells with looping trigger spells. 4.2.0: Label-based spell relationships, plus SimcSpell.Labels and SimcSpellEffect.MiscValue1/MiscValue2. AffectedBySpellIds/AffectedSpellIds may now contain more spells. 4.1.1: GetAvailableTalentsAsync added to ISimcGenerationService, XML documentation included, README fixes. 4.1.0: Spell relationships (SimcSpell.AffectedBySpellIds, SimcSpellEffect.AffectedSpellIds). 4.0.0 (breaking): requires .NET 10 (net9.0 dropped) and Microsoft.Extensions.*.Abstractions 10.x. No public API was removed. Full notes: https://github.com/MechanicalPriest/SimcProfileParser/blob/master/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="packageIcon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
	<None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>
</Project>
